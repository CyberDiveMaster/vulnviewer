vendor_repo_cache/
__pycache__/
*.pyc
.venv/
backfill_log*.txt

# The SQLite DB (~180MB+) is never committed to git -- it exceeds GitHub's
# 100MB per-file push limit. It persists only as a GitHub Actions cache
# entry (see .github/workflows/update.yml) and as a local working copy.
# Leading slash anchors this to the repo-root data/ dir only -- otherwise it
# would also match (and wrongly exclude) docs/data/.
/data/

# docs/data/cves-*.jsonl + docs/data/meta.json (see export_json.py) ARE
# committed -- uncompressed JSON Lines shards on purpose, so git can
# delta-compress between runs. This ignores a single-array "cves.json" some
# earlier local testing produced; not part of the current pipeline.
docs/data/cves.json
